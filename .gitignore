__pycache__/
*.py[cod]
.ipynb_checkpoints/

# 大型缓存、批量渲染图和 D2 合成图可以重新生成，不入库。
# 报告实际引用的图、指标、伪标签与学生模型检查点需要版本化，保证克隆后可直接编译报告。
results/*
!results/figures/
!results/figures/**
!results/metrics/
!results/metrics/**
!results/labels/
!results/labels/**
!results/student/
!results/student/**
data/*
!data/*.zip
!data/README.md

# LaTeX 编译中间产物
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.synctex.gz
# 署名信息不随公开仓库分发，缺失时标题下自动不排署名行
report/author.tex
report/*_backup.tex
report/*.pdf

.vscode/*
!.vscode/settings.json
